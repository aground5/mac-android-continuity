<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WifiLock(저지연 모드) acquire에 필요 — 없으면 SecurityException으로 앱 크래시 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 기본망 변경 감시(NetworkWatcher) — LTE↔Wi-Fi 핸드오버 시 ICE를 다시 돌리는 트리거.
         설치 시 자동 부여되는 normal 권한이라 런타임 요청이 필요 없다. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- BLE 페어링: Android는 peripheral(광고+GATT서버).

         ★ **스캔이 새로 필요해졌다.** 예전엔 폰이 상시 광고하고 Mac이 스캔했는데, 방향을
         뒤집어 Mac이 호출(paging)하고 폰은 오프로드 스캔만 걸어 둔다 — 상시 광고가 사라지는
         만큼이 그대로 배터리다.

         권한이 API로 갈린다. 어쩔 수 없이 둘 다 선언한다:
          - 31+ : BLUETOOTH_SCAN. 위치를 **뽑지 않는다**고 선언하면(neverForLocation)
                  위치 권한 없이 스캔할 수 있다. 우리는 실제로 스캔 결과에서 위치를
                  유도하지 않으므로 이 선언이 정직하다.
          - 29~30 : 레거시 스캔은 위치 권한을 요구한다. 31+에는 나가지 않게 막는다. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <!-- 레거시(≤30): 광고는 위치 불요(BLUETOOTH/ADMIN). 31+: ADVERTISE+CONNECT 런타임 권한. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- AOA(USB) bearer: Android = 액세서리. 케이블 연결 시 ATTACHED intent로 자동 실행/연결. -->
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />

    <!-- 화면 공유(앱 #2). MediaProjection은 mediaProjection 타입 포그라운드 서비스가 **먼저**
         떠 있어야만 얻을 수 있다(Android 14+) — 그래서 셋 다 필요하다.
         POST_NOTIFICATIONS는 런타임 권한(13+): 앱이 뒤에 있을 때 동의를 물어보는 유일한 통로다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 알림(앱 #4)이 **어느 앱의 알림인지** 말하려면 필요하다.
         Android 11+는 패키지 가시성을 막아서, 선언이 없으면 `getApplicationInfo`가
         NameNotFoundException을 던진다 → 앱 이름 자리에 패키지명이 그대로 나오고
         아이콘도 못 읽는다(실기기에서 "com.linkedin.android"로 나온 게 이것이다).
         알림은 **어떤 앱에서든** 올 수 있으므로 <queries>로 목록을 못 짠다.

         ⚠ Play 스토어에 올릴 때는 이 권한에 사유를 적어야 한다. 사이드로드 전용이면 무관. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- **알림을 눌러 폰에서 앱을 여는 데만** 쓴다. 오버레이 창을 그리지는 않는다.
         Android의 백그라운드 활동 시작(BAL) 규칙은 두 가지를 모두 요구한다:
         ① 발신자가 setPendingIntentBackgroundActivityStartMode로 옵트인하고
         ② 그 시점에 BAL 예외 중 하나를 만족할 것.
         우리가 만족시킬 수 있는 예외가 이것뿐이다 — 나머지는 화면에 창이 있거나(그럼
         백그라운드가 아니다), IME이거나, 시스템 서명 권한이라 해당이 없다.
         선언만으로는 아무 효과가 없고 **사용자가 설정에서 켜야** 한다. 안 켜도 알림 수신·
         답장·지우기는 전부 정상이다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 잠긴 화면을 **켜서** 잠금 해제를 청하는 데 쓴다. 전화 수신 화면이 쓰는 그 기전이다.
         평범한 알림은 화면을 켜지 않는다 — 소리만 나고 화면은 꺼진 채다.

         Android 14+에서는 통화·알람 앱이 아니면 기본으로 안 켜지고 **사용자가 설정에서
         허용**해야 한다. 허용 전에는 시스템이 알아서 보통 알림으로 낮춰서 보여주므로,
         없어도 "알림은 오되 화면이 안 켜지는" 정도로 부드럽게 물러선다. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PeriDisplay">
        <!-- Mac의 호출 광고가 오면 OS가 여기로 깨운다. 앱이 죽어 있어도 칩셋이 감시하다가
             매치될 때만 전달하므로, 폰이 상시 광고할 필요가 없어진다.

             exported=false: 우리 PendingIntent로만 불린다. 밖에서 부를 이유가 없다. -->
        <receiver
            android:name=".ble.PeriPageReceiver"
            android:exported="false" />

        <!-- singleTask: USB_ACCESSORY_ATTACHED가 앱 실행 중 중복 인스턴스를 만들지 않게
             (중복 시 컨트롤러 2개가 서피스/액세서리를 경합) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:theme="@style/Theme.PeriDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- AOA: Mac이 액세서리 모드 시작 시 이 앱을 실행/포그라운드로 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!-- 화면 공유가 도는 동안만 산다. 타입 선언이 곧 요건이다 — 이게 없으면
             getMediaProjection이 SecurityException을 던진다(Android 14+). -->
        <service
            android:name=".share.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 잠금 화면 위에 서서 잠금 해제를 청한다. 사용자가 알림을 눌러야 실행되므로
             (= 시스템이 보낸 PendingIntent) 백그라운드 시작 제한에 걸리지 않는다.
             showWhenLocked/turnScreenOn이 없으면 잠금 뒤에 가려져 아무것도 안 보인다. -->
        <activity
            android:name=".notify.NotifyUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 알림 읽기(앱 #4). 시스템이 바인드하므로 exported="true"이고, 권한으로 잠근다 —
             그 권한을 가진 건 시스템뿐이라 아무나 붙을 수 없다.
             **사용자가 설정에서 직접 허용해야** 바인드된다(런타임 권한이 아니다). -->
        <service
            android:name=".notify.PeriNotificationListener"
            android:exported="true"
            android:label="@string/notify_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>