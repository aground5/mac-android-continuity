<?xml version="1.0" encoding="utf-8"?>
<!-- AOA 액세서리 매칭. manufacturer/model/version이 Mac AoaServer의 AOA identify 문자열
     (string index 0/1/3)과 *정확히* 일치해야 이 앱이 ATTACHED intent로 실행된다. -->
<resources>
    <usb-accessory
        manufacturer="Peri Display"
        model="Mac Screen Extension"
        version="1.0" />
</resources>
